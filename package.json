{
  "name": "base-fulda",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "build": "esbuild assets/src/main.css --bundle --minify --outdir=assets/dist --entry-names=[name] --asset-names=fonts/[name]-[hash] --loader:.woff2=file --loader:.woff=file",
    "build:watch": "npm run build -- --watch",
    "dev": "concurrently -k \"php -S localhost:8000\" \"npm:build:watch\" \"browser-sync start --config bs-config.cjs\""
  },
  "devDependencies": {
    "@fontsource/anta": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bootstrap": "^5.3.8",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2"
  }
}
