# Leite HTTP auf HTTPS um
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://base-fulda.de%{REQUEST_URI} [L,R=301]

# Entferne doppelte Slashes (außer nach https://)
RewriteCond %{THE_REQUEST} //+
RewriteRule ^(.*)//+(.*)$ /$1/$2 [R=301,L]

# API unverändert an PHP durchreichen
RewriteRule ^api/ - [L]

# Echte Dateien/Verzeichnisse (gebaute Assets, favicon, background.mp4, ...) direkt ausliefern
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Alles andere an die SPA übergeben, React Router übernimmt das Routing
RewriteRule ^ index.html [L]
