# Leite HTTP auf HTTPS um
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://base-fulda.de%{REQUEST_URI} [L,R=301]

# Entferne doppelte Slashes (außer nach https://)
RewriteCond %{THE_REQUEST} //+
RewriteRule ^(.*)//+(.*)$ /$1/$2 [R=301,L]

# Optional: Trailing Slash entfernen (außer für Verzeichnisse und Dateien)
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteRule ^(.+)/$ /$1 [R=301,L]

# Optional: index.html entfernen
# RewriteCond %{THE_REQUEST} /index\.html [NC]
# RewriteRule ^(.*)index\.html$ /$1 [R=301,L]
